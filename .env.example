# Copy to .env (cp .env.example .env) and edit. .env is in .gitignore.
# Put values with spaces in quotes.

HASS_HOST=homeassistant.local
HASS_USER=root
HASS_PORT=22

# Dedicated SSH key (see README). Used with IdentitiesOnly.
HASS_SSH_KEY=~/.ssh/hass_deploy

# Config directory on Home Assistant. Leave empty to auto-detect
# (/config and /homeassistant are checked for configuration.yaml).
# Set a path here if detection gives the wrong answer.
HASS_CONFIG_DIR=

# Optional: file name of a dashboard that deploy.sh skips by default
# (only deployed with --protected, plus confirmation). Example: production.yaml
HASS_PROTECTED_DASHBOARD=

# Subdirectory (relative to the config directory) for the dashboards.
HASS_DASHBOARD_SUBDIR=dashboards

# Subdirectory (relative to the config directory) for the automations.
HASS_AUTOMATION_SUBDIR=automations

# Subdirectories (relative to the config directory) for scripts and scenes.
HASS_SCRIPT_SUBDIR=ha-scripts
HASS_SCENE_SUBDIR=ha-scenes

# Optional: to reload automations automatically after a deploy.
# Create a 'Long-lived access token' (profile > Security). Keep it secret.
# HASS_URL is the web URL of Home Assistant (default https://$HASS_HOST).
HASS_TOKEN=
HASS_URL=
