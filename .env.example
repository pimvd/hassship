# Kopieer naar .env (cp .env.example .env) en pas aan. .env staat in .gitignore.
# Waarden met spaties tussen aanhalingstekens zetten.

HASS_HOST=homeassistant.local
HASS_USER=root
HASS_PORT=22

# Dedicated SSH-sleutel (zie README). Wordt met IdentitiesOnly gebruikt.
HASS_SSH_KEY=~/.ssh/hass_deploy

# Configuratiemap op Home Assistant. Leeg laten = automatisch detecteren
# (/config en /homeassistant worden gecontroleerd op configuration.yaml).
# Zet hier een pad als detectie het verkeerde antwoord geeft.
HASS_CONFIG_DIR=

# Optioneel: bestandsnaam van een dashboard dat deploy.sh standaard overslaat
# (alleen met --protected, plus bevestiging). Bijvoorbeeld: productie.yaml
HASS_PROTECTED_DASHBOARD=

# Submap (relatief aan de configuratiemap) waar de dashboards komen.
HASS_DASHBOARD_SUBDIR=dashboards

# Submap (relatief aan de configuratiemap) waar de automations komen.
HASS_AUTOMATION_SUBDIR=automations

# Optioneel: om automations na een deploy automatisch te herladen.
# Maak een 'Langlevende toegangstoken' aan (profiel > Beveiliging). Houd hem geheim.
# HASS_URL is de web-URL van Home Assistant (standaard https://$HASS_HOST).
HASS_TOKEN=
HASS_URL=
