# Voorbeeld (niet actief: bestandsnaam eindigt op .disabled).
# Hernoem naar <naam>.yaml om te gebruiken. Elk bestand moet een LIJST van automations zijn.
- id: voorbeeld_lamp_bij_zonsondergang
  alias: Voorbeeld - lamp aan bij zonsondergang
  triggers:
    - trigger: sun
      event: sunset
  actions:
    - action: light.turn_on
      target:
        entity_id: light.woonkamer
